{
  "name": "design-system-impact",
  "version": "0.1.0",
  "description": "Deterministic semantic impact analysis and migration planning for design systems",
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "design-system-impact": "./dist/cli.js", "dsi": "./dist/cli.js" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./schemas/*": "./schemas/*"
  },
  "types": "./dist/index.d.ts",
  "files": ["dist", "schemas", "README.md", "LICENSE", "CHANGELOG.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --max-warnings=0",
    "test": "vitest run",
    "test:package": "node test/package-smoke.mjs",
    "check": "npm run typecheck && npm run lint && npm run build && npm test && npm run test:package",
    "release:check": "npm run check && npm audit --omit=dev && npm pack --dry-run",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "keywords": ["design-system", "migration", "react", "typescript", "design-tokens", "codemod", "cli"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/hanifb1360/design-system-impact.git" },
  "bugs": { "url": "https://github.com/hanifb1360/design-system-impact/issues" },
  "homepage": "https://github.com/hanifb1360/design-system-impact#readme",
  "publishConfig": { "access": "public", "provenance": true },
  "dependencies": { "typescript": "^5.9.2" },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.18.1",
    "ajv": "^8.17.1",
    "eslint": "^9.35.0",
    "typescript-eslint": "^8.42.0",
    "vitest": "^4.1.11"
  }
}
