{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-system-impact.dev/schemas/common.schema.json",
  "$defs": {
    "package": {
      "type": "object",
      "required": ["name"],
      "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "type": "string" } },
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "required": ["file", "line", "column"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "impactLocation": {
      "type": "object",
      "required": ["file", "line", "column"],
      "properties": {
        "file": { "type": "string", "minLength": 1 }, "line": { "type": "integer", "minimum": 1 }, "column": { "type": "integer", "minimum": 1 },
        "workspace": { "type": "string" }, "owner": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": ["code", "severity", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^DSI[0-9]+$" },
        "severity": { "enum": ["info", "warning", "error"] },
        "message": { "type": "string", "minLength": 1 },
        "location": { "$ref": "#/$defs/location" },
        "related": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
